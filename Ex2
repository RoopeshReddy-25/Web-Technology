<!-- Home Decor Form -->
<div>

    <h2>Subscribe to Our Home Decor Blog</h2>

    <form action="#" method="post">

        <fieldset>

            <legend>Subscriber Details</legend>

            <label for="name">Full Name:</label><br>
            <input type="text" id="name" name="name" required><br><br>

            <label for="email">Email:</label><br>
            <input type="email" id="email" name="email" required><br><br>

            <label for="phone">Phone Number:</label><br>
            <input type="tel" id="phone" name="phone"><br><br>

            <label for="style">Favorite Decor Style:</label><br>

            <select id="style" name="style">

                <option>Modern</option>
                <option>Minimalist</option>
                <option>Traditional</option>
                <option>Rustic</option>
                <option>Bohemian</option>

            </select>

            <br><br>

            <label>Interested In:</label><br>

            <input type="checkbox" id="living" name="room">
            <label for="living">Living Room</label><br>

            <input type="checkbox" id="bedroom" name="room">
            <label for="bedroom">Bedroom</label><br>

            <input type="checkbox" id="kitchen" name="room">
            <label for="kitchen">Kitchen</label>

            <br><br>

            <label>Subscription Plan:</label><br>

            <input type="radio" id="basic" name="plan">
            <label for="basic">Basic</label><br>

            <input type="radio" id="premium" name="plan">
            <label for="premium">Premium</label>

            <br><br>

            <label for="comments">Comments:</label><br>

            <textarea id="comments" rows="5" cols="40"
                placeholder="Write your ideas here..."></textarea>

            <br><br>

            <label>Profile Completion:</label><br>

            <progress value="70" max="100"></progress>

            <br><br>

            <input type="submit" value="Subscribe">
            <input type="reset" value="Reset">

        </fieldset>

    </form>

</div>
</body>
